{
  "appId": "it.prolocoportale.proximap",
  "appName": "ProxiMap",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#D96C4A",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "light"
    }
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": true
  }
}
